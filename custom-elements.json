{
  "schemaVersion": "1.0.0",
  "readme": "Elementum Design System Custom Elements Manifest",
  "modules": [
    {
      "kind": "javascript-module",
      "path": "src/components/el-button.js",
      "declarations": [
        {
          "kind": "class",
          "name": "ElButton",
          "tagName": "el-button",
          "description": "Frameworkless, signal-driven button component with 1:1 Figma variant parity.",
          "superclass": {
            "name": "Elementum",
            "module": "src/index.js"
          },
          "attributes": [
            {
              "name": "variant",
              "description": "Visual style variant matching Figma component property.",
              "type": { "text": "'primary' | 'secondary' | 'danger' | 'ghost'" },
              "default": "'primary'"
            },
            {
              "name": "size",
              "description": "Button dimensions matching Figma size property.",
              "type": { "text": "'sm' | 'md' | 'lg'" },
              "default": "'md'"
            },
            {
              "name": "disabled",
              "description": "Whether the button is interactive.",
              "type": { "text": "boolean" },
              "default": "false"
            }
          ],
          "slots": [
            {
              "name": "",
              "description": "Primary button label text."
            },
            {
              "name": "prefix",
              "description": "Icon or element placed before the label."
            },
            {
              "name": "suffix",
              "description": "Icon or badge placed after the label."
            }
          ],
          "events": [
            {
              "name": "click",
              "description": "Fired when user clicks the button (suppressed if disabled)."
            }
          ],
          "cssParts": [
            {
              "name": "button",
              "description": "The internal native <button> element inside the shadow root."
            }
          ]
        }
      ],
      "exports": [
        {
          "kind": "custom-element-definition",
          "name": "el-button",
          "declaration": {
            "name": "ElButton",
            "module": "src/components/el-button.js"
          }
        }
      ]
    },
    {
      "kind": "javascript-module",
      "path": "src/components/el-badge.js",
      "declarations": [
        {
          "kind": "class",
          "name": "ElBadge",
          "tagName": "el-badge",
          "description": "Minimal status indicator and notification badge.",
          "superclass": {
            "name": "Elementum",
            "module": "src/index.js"
          },
          "attributes": [
            {
              "name": "variant",
              "description": "Badge color variant.",
              "type": { "text": "'default' | 'success' | 'danger'" },
              "default": "'default'"
            },
            {
              "name": "count",
              "description": "Count or short text to display.",
              "type": { "text": "string" }
            }
          ],
          "slots": [
            {
              "name": "",
              "description": "Badge content or label."
            }
          ],
          "cssParts": [
            {
              "name": "badge",
              "description": "The internal badge <span> wrapper."
            }
          ]
        }
      ],
      "exports": [
        {
          "kind": "custom-element-definition",
          "name": "el-badge",
          "declaration": {
            "name": "ElBadge",
            "module": "src/components/el-badge.js"
          }
        }
      ]
    },
    {
      "kind": "javascript-module",
      "path": "src/components/el-input.js",
      "declarations": [
        {
          "kind": "class",
          "name": "ElInput",
          "tagName": "el-input",
          "description": "Accessible text/form input with prefix/suffix slots and design token styling.",
          "superclass": { "name": "Elementum", "module": "src/index.js" },
          "attributes": [
            { "name": "value", "type": { "text": "string" } },
            { "name": "placeholder", "type": { "text": "string" } },
            { "name": "disabled", "type": { "text": "boolean" } },
            { "name": "readonly", "type": { "text": "boolean" } },
            { "name": "size", "type": { "text": "'sm' | 'md' | 'lg'" }, "default": "'md'" }
          ],
          "slots": [
            { "name": "prefix", "description": "Leading element or icon." },
            { "name": "suffix", "description": "Trailing element or clear button." }
          ],
          "events": [
            { "name": "input", "description": "Fired on every character typed." },
            { "name": "change", "description": "Fired on commit/blur." }
          ]
        }
      ],
      "exports": [
        {
          "kind": "custom-element-definition",
          "name": "el-input",
          "declaration": { "name": "ElInput", "module": "src/components/el-input.js" }
        }
      ]
    },
    {
      "kind": "javascript-module",
      "path": "src/components/el-dropdown.js",
      "declarations": [
        {
          "kind": "class",
          "name": "ElDropdown",
          "tagName": "el-dropdown",
          "description": "Accessible overlay container with light-dismiss and trigger slot.",
          "superclass": { "name": "Elementum", "module": "src/index.js" },
          "attributes": [
            { "name": "open", "type": { "text": "boolean" }, "default": "false" }
          ],
          "slots": [
            { "name": "trigger", "description": "Trigger element that toggles the dropdown." },
            { "name": "", "description": "Dropdown overlay content." }
          ],
          "events": [
            { "name": "open", "description": "Fired when dropdown opens." },
            { "name": "close", "description": "Fired when dropdown closes." }
          ]
        }
      ],
      "exports": [
        {
          "kind": "custom-element-definition",
          "name": "el-dropdown",
          "declaration": { "name": "ElDropdown", "module": "src/components/el-dropdown.js" }
        }
      ]
    },
    {
      "kind": "javascript-module",
      "path": "src/components/el-calendar.js",
      "declarations": [
        {
          "kind": "class",
          "name": "ElCalendar",
          "tagName": "el-calendar",
          "description": "Standalone accessible calendar month-grid component.",
          "superclass": { "name": "Elementum", "module": "src/index.js" },
          "attributes": [
            { "name": "value", "type": { "text": "string" }, "description": "Selected date formatted as YYYY-MM-DD" }
          ],
          "events": [
            { "name": "select", "description": "Fired when a date cell is selected: detail.date" }
          ]
        }
      ],
      "exports": [
        {
          "kind": "custom-element-definition",
          "name": "el-calendar",
          "declaration": { "name": "ElCalendar", "module": "src/components/el-calendar.js" }
        }
      ]
    },
    {
      "kind": "javascript-module",
      "path": "src/components/el-datepicker.js",
      "declarations": [
        {
          "kind": "class",
          "name": "ElDatepicker",
          "tagName": "el-datepicker",
          "description": "Composite Datepicker combining <el-dropdown>, <el-input>, <el-calendar>, and <el-button>.",
          "superclass": { "name": "Elementum", "module": "src/index.js" },
          "attributes": [
            { "name": "value", "type": { "text": "string" }, "description": "Selected date in YYYY-MM-DD format" },
            { "name": "placeholder", "type": { "text": "string" }, "default": "'Select date...'" },
            { "name": "disabled", "type": { "text": "boolean" }, "default": "false" }
          ],
          "events": [
            { "name": "change", "description": "Fired when the user selects or clears a date: detail.value" }
          ]
        }
      ],
      "exports": [
        {
          "kind": "custom-element-definition",
          "name": "el-datepicker",
          "declaration": { "name": "ElDatepicker", "module": "src/components/el-datepicker.js" }
        }
      ]
    }
  ]
}
