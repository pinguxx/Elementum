          "slots": [
            { "name": "", "description": "Primary button label text." },
            { "name": "prefix", "description": "Icon or element placed before the label." },
            { "name": "suffix", "description": "Icon or badge placed after the label." }
          ],
          "events": [
            { "name": "click", "description": "Fired when user clicks the button." }
          ]
        }
      ]
    },
