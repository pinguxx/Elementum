{
  "name": "@wcomp/elementum",
  "version": "0.4.0",
  "description": "Ultra-lightweight, signal-driven, frameworkless Web Components for modern design systems",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "elementum-mcp": "./mcp/server.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "custom-elements.json",
    "tokens",
    "mcp",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./ssr": "./src/ssr.js",
    "./ag-ui": "./src/ag-ui.js",
    "./behaviors": "./src/behaviors/index.js",
    "./tokens.css": "./src/tokens.css",
    "./custom-elements.json": "./custom-elements.json",
    "./components/*.js": "./src/components/*.js",
    "./components/*": "./src/components/*.js"
  },
  "homepage": "https://elementum-sage.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinguxx/Elementum.git"
  },
  "bugs": {
    "url": "https://github.com/pinguxx/Elementum/issues"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit --strict --lib es2022,dom --target es2022 src/index.d.ts",
    "verify:consumer": "node tools/verify-consumer.js",
    "quality:report": "node tools/generate-quality-report.js",
    "verify:all": "npm run catalog:diff && npm run typecheck && npm test && npm run verify:consumer && npm run test:e2e",
    "bench": "node tools/benchmark.js",
    "serve": "node tools/serve.js",
    "serve:proxy": "node tools/serve.js --proxy",
    "ssr": "node examples/ssr-server.js",
    "ssr:static": "node examples/ssr-server.js --static examples/ssr-demo.html",
    "mcp": "node mcp/server.js",
    "create": "node tools/create-component.js",
    "tokens:sync": "node tools/sync-tokens.js",
    "catalog:diff": "node tools/audit-catalog-diff.js",
    "penpot:mcp": "node tools/sync-penpot-mcp.js",
    "penpot:design-app": "node tools/design-ledgerflow-penpot.js",
    "penpot:generate": "node tools/penpot-to-elementum.js"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "signals",
    "shadow-dom",
    "declarative-shadow-dom",
    "ssr",
    "design-system",
    "figma",
    "penpot",
    "mcp",
    "ai-ui"
  ],
  "author": "wcomp",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2"
  }
}
