{
  "name": "@wc/elementum",
  "version": "0.1.0",
  "description": "Ultra-lightweight, signal-driven, frameworkless Web Components for modern design systems",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "bin": {
    "elementum-mcp": "./mcp/server.js"
  },
  "files": [
    "src",
    "custom-elements.json",
    "tokens",
    "mcp"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./ssr": "./src/ssr.js",
    "./tokens.css": "./src/tokens.css",
    "./custom-elements.json": "./custom-elements.json"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage",
    "serve": "node tools/serve.js",
    "serve:proxy": "node tools/serve.js --proxy",
    "mcp": "node mcp/server.js",
    "create": "node tools/create-component.js",
    "tokens:sync": "node tools/sync-tokens.js",
    "penpot:mcp": "node tools/sync-penpot-mcp.js",
    "penpot:design-app": "node tools/design-ledgerflow-penpot.js",
    "penpot:generate": "node tools/penpot-to-elementum.js"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "signals",
    "shadow-dom",
    "figma",
    "design-system",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "happy-dom": "^21.0.4"
  }
}
